					"match": "(?i)(?<![A-Za-z0-9_$#@])(?:drive\\$(?![A-Za-z0-9_$#])|physic(?![A-Za-z0-9_$#])|date\\$(?![A-Za-z0-9_$#])|drive(?![A-Za-z0-9_$#])|logic(?![A-Za-z0-9_$#])|time\\$(?![A-Za-z0-9_$#])|timer(?![A-Za-z0-9_$#])|areg(?![A-Za-z0-9_$#])|back(?![A-Za-z0-9_$#])|dir\\$(?![A-Za-z0-9_$#])|dreg(?![A-Za-z0-9_$#])|pof(?![A-Za-z0-9_$#]))"
				}
			]
		},
		"operator": {
			"name": "keyword.operator.stos",
			"match": "<=|<>|>=|-|\\*|\\/|\\^|\\+|<|=|>"
		},
		"separator": {
			"comment": "the colon between two instructions on one line",
			"match": ":",
			"name": "punctuation.separator.statement.stos"
		}
	}
}
