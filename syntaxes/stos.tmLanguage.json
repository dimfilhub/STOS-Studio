		},
		{
			"include": "#commands"
		},
		{
			"include": "#operator"
		},
		{
			"include": "#separator"
		}
	],
	"repository": {
		"directive": {
			"comment": "#include \"file\" and #lineinc n, at the start of a line (read by the STOS Studio converter)",
			"match": "(?i)^\\s*(#(?:include|lineinc))\\b(.*)$",
			"captures": {
				"1": {
					"name": "keyword.control.directive.stos"
				},
				"2": {
					"patterns": [
						{
							"include": "#string"
						},
						{
							"include": "#number"
						}
					]
				}
			}
		},
		"line-number": {
			"comment": "a line number at the start of a line, as in an .asc file",
			"match": "^\\s*(\\d+)",
			"captures": {
				"1": {
					"name": "constant.numeric.line-number.stos"
				}
			}
		},
		"source-comment": {
			"comment": "a line starting with ' or // (after any labels) is a comment the converter drops",
			"match": "^\\s*((?:@[\\p{L}\\p{N}_]+\\s*)*)((?:'|//).*)$",
			"captures": {
				"1": {
					"name": "entity.name.function.label.stos"
				},
				"2": {
					"name": "comment.line.source.stos"
				}
			}
		},
		"label-definition": {
			"comment": "a @label at the start of a line marks that line",
			"match": "^\\s*(@[\\p{L}\\p{N}_]+)",
			"captures": {
				"1": {
					"name": "entity.name.function.label.stos"
				}
			}
		},
		"label": {
			"comment": "a @label used instead of a line number (goto @loop)",
			"match": "@[\\p{L}\\p{N}_]+",
			"name": "entity.name.label.stos"
		},
		"comment": {
			"comment": "REM: the rest of the line is a comment",
			"match": "(?i)(?<![A-Za-z0-9_$#@])(rem)(?![A-Za-z0-9_$#])(.*)$",
			"captures": {
				"1": {
					"name": "comment.line.rem.stos keyword.other.rem.stos"
				},
				"2": {
					"name": "comment.line.rem.stos"
				}
			}
		},
		"string": {
			"comment": "STOS strings have no escape characters; a string may run to the end of the line",
			"match": "\"[^\"]*(?:\"|$)",
			"name": "string.quoted.double.stos"
		},
		"number": {
			"patterns": [
				{
					"name": "constant.numeric.hex.stos",
					"match": "(?<![A-Za-z0-9_$#@])\\$[0-9A-Fa-f]+"
				},
				{
					"name": "constant.numeric.binary.stos",
					"match": "(?<![A-Za-z0-9_$#@])%[01]+"
				},
				{
					"name": "constant.numeric.decimal.stos",
